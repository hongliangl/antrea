# Compile natively on the build host; both architectures emit bpfel instructions.
ARG GO_VERSION
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS go

FROM --platform=$BUILDPLATFORM ubuntu:24.04 AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends clang-18 linux-libc-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" CGO_ENABLED=0

WORKDIR /src
COPY hack/gen-bpf-objects/main.go ./gen-bpf-objects.go
COPY pkg/agent/ebpf/bpf/host_datapath.bpf.c ./host_datapath.bpf.c

RUN clang-18 -O2 -g -target bpfel -I/usr/include/$(uname -m)-linux-gnu \
        -c host_datapath.bpf.c -o host_datapath.o && \
    go run gen-bpf-objects.go -obj host_datapath.o -src host_datapath.bpf.c \
        -package objects -out objects_linux.go

FROM scratch
COPY --from=build /src/objects_linux.go /
